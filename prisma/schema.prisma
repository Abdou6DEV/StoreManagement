generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "darwin", "darwin-arm64", "windows"]
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Stock {
  id        String   @id @default(uuid())
  product   String
  type      String
  quantity  Int
  bought    Int
  selling   Int
  codebar   String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
