generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "darwin", "darwin-arm64", "windows"]
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Category {
  name     String    @id
  products Product[]
}

model Product {
  id           String   @id @default(uuid())
  name         String
  categoryName String
  quantity     Int
  bought       Int
  selling      Int
  codebar      String?  @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  category Category   @relation(fields: [categoryName], references: [name])
  SaleItem SaleItem[]
}

model Sale {
  id       String     @id @default(uuid())
  SaleItem SaleItem[]
}

model SaleItem {
  productId String
  quantity  Int
  price     Int
  SaleId    String

  product Product @relation(fields: [productId], references: [id])
  sale    Sale    @relation(fields: [SaleId], references: [id])

  @@id([productId, SaleId])
}
