generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "darwin", "darwin-arm64", "windows"]
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

enum PaymentType {
  CREDIT
  VERSEMENT
}

enum UserRole {
  ADMIN
  USER
}

model User {
  id       String   @id @default(uuid())
  username String   @unique
  email    String?
  password String
  role     UserRole @default(USER)
  isActive Boolean  @default(true)

  // User permissions for different pages
  permissions UserPermissions?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserPermissions {
  id     String @id @default(uuid())
  userId String @unique

  // Page access permissions
  canAccessCashier   Boolean @default(false)
  canAccessStock     Boolean @default(false)
  canAccessClients   Boolean @default(false)
  canAccessBills     Boolean @default(false)
  canAccessHistory   Boolean @default(false)
  canAccessDashboard Boolean @default(false)
  canAccessServices  Boolean @default(false)
  canAccessZakat     Boolean @default(false)

  // Admin permissions (only for admin role)
  canManageUsers    Boolean @default(false)
  canViewLogs       Boolean @default(false)
  canManageSettings Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Category {
  name     String    @id
  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id           String  @id @default(uuid())
  name         String  @unique
  categoryName String
  quantity     Int
  boughtPrice  Int
  sellingPrice Int
  codebar      String?
  photo        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category      Category       @relation(fields: [categoryName], references: [name], onDelete: Cascade)
  saleItems     SaleItem[]
  PurchaseItems PurchaseItem[]

  @@index([categoryName])
  @@index([name])
}

model ManualProduct {
  id        String @id @default(uuid())
  name      String
  type      String
  costPrice Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  saleItems SaleItem[]

  @@unique([name, type])
}

model Service {
  id                   String  @id @default(uuid())
  name                 String  @unique
  description          String?
  costPrice            Int     @default(0)
  serviceAppointmentId String? // Link back to the original ServiceAppointment

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  saleItems SaleItem[]

  @@index([serviceAppointmentId])
}

model Sale {
  id       String  @id @default(uuid())
  clientId String?
  discount Int     @default(0)

  // Pre-calculated totals for performance
  totalAmount             Int @default(0) // Sum of all item prices * quantities
  totalAmountWithDiscount Int @default(0) // totalAmount - discount
  totalItems              Int @default(0) // Sum of all quantities
  totalCost               Int @default(0) // Sum of all boughtPrice * quantities
  totalProfit             Int @default(0) // totalAmountWithDiscount - totalCost

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client    Client?    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  payment   Payment?
  saleItems SaleItem[]

  @@index([clientId])
  @@index([createdAt])
  @@index([clientId, createdAt])
}

model SaleItem {
  id              String  @id @default(uuid())
  productId       String?
  manualProductId String?
  serviceId       String?
  saleId          String
  quantity        Int
  price           Int
  boughtPrice     Int? // Store the bought price at time of sale

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product       Product?       @relation(fields: [productId], references: [id], onDelete: Cascade)
  manualProduct ManualProduct? @relation(fields: [manualProductId], references: [id], onDelete: Cascade)
  service       Service?       @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  sale          Sale           @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@unique([productId, saleId])
  @@unique([manualProductId, saleId])
  @@unique([serviceId, saleId])
  @@index([productId])
  @@index([saleId])
  @@index([serviceId])
}

model Client {
  id      String  @id @default(uuid())
  name    String  @unique
  phone   String?
  address String?
  notes   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sales               Sale[]
  payments            Payment[]
  serviceAppointments ServiceAppointment[]
}

model Option {
  key   String @id
  value String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Payment {
  id               String      @id @default(uuid())
  saleId           String?     @unique
  clientId         String
  givenAmount      Int
  creditAmount     Int? // For standalone credits: total amount we owe the client
  dueDate          DateTime
  paidDate         DateTime?
  type             PaymentType
  pendingSaleItems String? // JSON string of cart items for VERSEMENT payments
  discount         Int? // Discount amount for VERSEMENT payments

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sale   Sale?  @relation(fields: [saleId], references: [id], onDelete: Cascade)
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model Seller {
  id      String  @id @default(uuid())
  name    String  @unique
  phone   String?
  email   String?
  address String?
  notes   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchases Purchase[]
}

model Purchase {
  id       String  @id @default(uuid())
  sellerId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  seller        Seller?        @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  PurchaseItems PurchaseItem[]
}

model PurchaseItem {
  id         String @id @default(uuid())
  productId  String
  purchaseId String
  quantity   Int
  price      Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
}

model Bill {
  id           String   @id @default(uuid())
  title        String
  description  String?
  type         String // Custom bill type (user can type anything)
  amount       Int // Amount in centimes (DA * 100)
  nextBillDate DateTime // Next bill due date
  duration     String // "NO_NEXT", "1_MONTH", "2_MONTHS", "3_MONTHS", "4_MONTHS", "5_MONTHS", "6_MONTHS", "7_MONTHS", "8_MONTHS", "9_MONTHS", "10_MONTHS", "11_MONTHS", "ANNUALLY"
  notes        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Payment history
  payments BillPayment[]
}

model BillPayment {
  id       String   @id @default(uuid())
  billId   String
  amount   Int // Amount paid in centimes (DA * 100)
  paidDate DateTime @default(now())
  notes    String?

  createdAt DateTime @default(now())

  // Relations
  bill Bill @relation(fields: [billId], references: [id], onDelete: Cascade)
}

model ServiceAppointment {
  id           String    @id @default(uuid())
  name         String
  serviceType  String
  description  String?
  costPrice    Int       @default(0)
  servicePrice Int       @default(0)
  clientId     String?
  dueDate      DateTime
  notes        String?
  isCompleted  Boolean   @default(false)
  completedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  client Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([isCompleted])
  @@index([completedAt])
  @@index([clientId])
}

// Activity/audit log: every user action (login, edit client, record sale, etc.)
model ActivityLog {
  id       String   @id @default(uuid())
  username String   // Who performed the action
  action   String   // e.g. "login", "edit_client", "record_sale"
  details  String?  // Optional JSON or human-readable detail (e.g. client name, sale id)
  createdAt DateTime @default(now())

  @@index([username])
  @@index([createdAt])
  @@index([username, createdAt])
}
