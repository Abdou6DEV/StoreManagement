{
  "name": "reda-tech-store-management",
  "productName": "REDA TECH Store Management",
  "version": "5.1.2",
  "description": "A comprehensive store management solution by REDA TECH",
  "main": ".vite/build/main.js",
  "scripts": {
    "start": "electron-forge start",
    "package": "npm run prisma:generate && electron-forge package",
    "make": "npm run prisma:generate && electron-forge make",
    "publish": "electron-forge publish",
    "build:landing": "vite build --config vite.landing.config.mts && node -e \"require('fs').renameSync('docs/landing.html','docs/index.html')\"",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write .",
    "db:seed": "tsx prisma/seed/index.ts",
    "logs:seed": "ts-node scripts/seedLogs.ts --",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed/index.ts"
  },
  "keywords": [],
